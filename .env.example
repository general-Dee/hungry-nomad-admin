NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only secret (Dashboard > Settings > API > service_role). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) -- sends admin-invite emails ourselves (instead
# of Supabase's built-in mailer) so delivery/bounce/spam status can be
# tracked via webhooks. Dashboard > API Keys.
RESEND_API_KEY=
# Sender identity, must use a domain verified in Resend (Dashboard > Domains),
# e.g. "Hungry Nomad Admin <admin@yourdomain.com>". Until a domain is
# verified, Resend's shared sandbox sender can only deliver to your own
# Resend account email -- not to arbitrary invited admins.
RESEND_FROM_EMAIL=
# Signing secret for the webhook endpoint (Dashboard > Webhooks > your
# endpoint > Signing Secret). Verified via svix in
# src/app/api/webhooks/resend/route.ts. Requires a publicly reachable HTTPS
# URL (Resend can't reach http://localhost); use ngrok or similar for local testing.
RESEND_WEBHOOK_SECRET=
