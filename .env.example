NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only secret (Dashboard > Settings > API > service_role). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) -- sends admin-invite emails ourselves (instead
# of Supabase's built-in mailer) so delivery/bounce/spam status can be
# tracked via webhooks. Dashboard > API Keys.
RESEND_API_KEY=
# Sender identity, must use a domain verified in Resend (Dashboard > Domains),
# e.g. "Hungry Nomad Admin <admin@yourdomain.com>". Until a domain is
# verified, Resend's shared sandbox sender can only deliver to your own
# Resend account email -- not to arbitrary invited admins.
RESEND_FROM_EMAIL=
# Signing secret for the webhook endpoint (Dashboard > Webhooks > your
# endpoint > Signing Secret). Verified via svix in
# src/app/api/webhooks/resend/route.ts. Requires a publicly reachable HTTPS
# URL (Resend can't reach http://localhost); use ngrok or similar for local testing.
RESEND_WEBHOOK_SECRET=

# Termii (https://termii.com) -- sends SMS to staff when a new order is
# placed, via the AFTER INSERT trigger in
# supabase/migrations/20260806120000_order_sms_notification_trigger.sql and
# src/app/api/webhooks/order-created/route.ts. Dashboard > Settings > API Keys.
TERMII_API_KEY=
# Sender ID shown as the SMS sender. Termii's shared default "Termii" is
# NOT usable on any channel for Nigerian numbers -- NCC regulations require
# a Sender ID to be registered and approved in the Dashboard (Settings >
# Sender ID) before any SMS can send. Confirmed by a live SENDER_ID_NOT_APPROVED
# error from Termii's API; this must be a real, approved sender ID.
TERMII_SENDER_ID=
# Comma-separated E.164 phone numbers to notify on every new order (e.g.
# +2348011112222,+2348033334444). A plain env var rather than a DB table
# since this is a small, rarely-changing set.
STAFF_NOTIFICATION_PHONE_NUMBERS=
# Shared secret the order-created webhook route checks against the
# x-order-sms-webhook-secret header. Must match the literal value pasted into
# the trigger's supabase_functions.http_request headers in
# supabase/migrations/20260806120000_order_sms_notification_trigger.sql --
# that file only has a placeholder, the real value only lives here and in the
# Dashboard SQL Editor at apply-time. Requires a publicly reachable HTTPS URL
# (Supabase can't reach http://localhost); use ngrok or similar for local testing.
ORDER_SMS_WEBHOOK_SECRET=
